{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"rules": {
		"no-unused-vars": [
			"error",
			{
				"ignoreRestSiblings": true
			}
		],
		"typescript/no-floating-promises": "error"
	},
	"overrides": [
		{
			"files": ["test/**"],
			"rules": {
				"typescript/no-floating-promises": "off"
			}
		}
	]
}
