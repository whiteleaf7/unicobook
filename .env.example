# cp .env.example .env して値を書き換える（.env は git 管理外）。
# 値は ~ で始めるとホームディレクトリとして扱う。すでに設定されている環境変数があればそちらが優先される。

# 配信する小説フォルダ（必須）
UNICOBOOK_ROOT="~/Library/Mobile Documents/com~apple~CloudDocs/novels"
# Linux の例
# UNICOBOOK_ROOT="~/novels"

# 開発モード。1 にすると、pnpm build で作った dist/ ではなく public/ をビルドせずにそのまま配信する
# UNICOBOOK_DEV=1

# 待ち受けるポート（127.0.0.1 だけで待ち受ける）
# UNICOBOOK_PORT=8787

# localhost と *.ts.net 以外のホスト名でアクセスするなら、カンマ区切りで追加する
# UNICOBOOK_ALLOWED_HOSTS=reader.example.com

# 縮小した画像や、Gemini でアイコンを作るときの作業ファイルを置く場所
# UNICOBOOK_CACHE_DIR="~/Library/Caches/unicobook"
# Linux の既定値は $XDG_CACHE_HOME/unicobook（XDG_CACHE_HOME が無ければ ~/.cache/unicobook）
# UNICOBOOK_CACHE_DIR="~/.cache/unicobook"

# 読書位置・設定・アイコンの選択などを保存する場所
# UNICOBOOK_DATA_DIR="~/Library/Application Support/unicobook"
# Linux の既定値は $XDG_DATA_HOME/unicobook（XDG_DATA_HOME が無ければ ~/.local/share/unicobook）
# UNICOBOOK_DATA_DIR="~/.local/share/unicobook"

# Gemini でのアイコン作りに使う Antigravity の CLI とモデル、会話ごとのファイルが置かれる場所
# UNICOBOOK_AGY="~/.local/bin/agy"
# UNICOBOOK_AGY_MODEL=gemini-3.8-flash-medium
# UNICOBOOK_AGY_BRAIN_DIR="~/.gemini/antigravity-cli/brain"
