# cp .env.example .env して値を書き換える（.env は git 管理外）。
# 値は ~ で始めるとホームディレクトリとして扱う。すでに設定されている環境変数があればそちらが優先される。

# 配信する小説フォルダ（必須）
NOVELBOOK_ROOT="~/Library/Mobile Documents/com~apple~CloudDocs/novels"

# 待ち受けるポート（127.0.0.1 だけで待ち受ける）
# NOVELBOOK_PORT=8787

# localhost と *.ts.net 以外のホスト名でアクセスするなら、カンマ区切りで追加する
# NOVELBOOK_ALLOWED_HOSTS=reader.example.com

# 縮小した画像や、Gemini でアイコンを作るときの作業ファイルを置く場所
# NOVELBOOK_CACHE_DIR="~/Library/Caches/novelbook"

# 読書位置・設定・アイコンの選択などを保存する場所
# NOVELBOOK_DATA_DIR="~/Library/Application Support/novelbook"

# Gemini でのアイコン作りに使う Antigravity の CLI とモデル、会話ごとのファイルが置かれる場所
# NOVELBOOK_AGY="~/.local/bin/agy"
# NOVELBOOK_AGY_MODEL=gemini-3.8-flash-medium
# NOVELBOOK_AGY_BRAIN_DIR="~/.gemini/antigravity-cli/brain"
